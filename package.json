{
  "name": "odometer-app",
  "description": "Odometer Tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "npm run install && npm run login",
    "install": "npm --prefix frontend install && npm --prefix backend install",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "login": "npm --prefix backend run login",
    "push": "npm --prefix backend run push",
    "deploy": "npm --prefix frontend run deploy"
  }
}
