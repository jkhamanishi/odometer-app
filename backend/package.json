{
  "name": "odometer-app-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "login": "clasp login",
    "tsc": "tsc --noEmit",
    "bundle": "node esbuild.config.js",
    "build": "npm run tsc && npm run bundle",
    "push": "npm run build && clasp push",
    "deploy": "npm run push && clasp deploy -i"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.12",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  }
}
